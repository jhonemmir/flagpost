{
  "vectorsVersion": 1,
  "description": "Shared contract vectors for the flag evaluation algorithm. Every implementation (PHP API, C# SDK) must pass all of them. vectorsVersion describes the format of this file; the wire schemaVersion in GET /v1/sdk/flags is a separate counter.",
  "algorithm": {
    "bucketInput": "UTF-8 bytes of '{flagKey}:{userId}'",
    "hash": "SHA-256",
    "bucket": "first 4 bytes of the digest as a big-endian unsigned 32-bit integer, modulo 100 (range 0-99)",
    "inside": "bucket < percentage"
  },
