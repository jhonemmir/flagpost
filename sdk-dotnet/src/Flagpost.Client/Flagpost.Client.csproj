<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Flagpost.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>flagpost contributors</Authors>
    <Company>flagpost</Company>
    <Copyright>Copyright (c) 2026 flagpost contributors</Copyright>
    <Description>Feature flags with client-side evaluation for .NET. Polls a Flagpost API, keeps the last good snapshot and evaluates locally.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jhonemmir/flagpost</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jhonemmir/flagpost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>feature-flags;feature-toggle;configuration;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flagpost.Client.Tests" />
  </ItemGroup>

</Project>
